        },
        "asm-check-valve-dimensions": {
          "description": "Illustrative DN50 check valve: face-to-face length 0.18 m and body diameter 0.11 m. Its inlet-to-outlet direction follows process flow.",
          "source": "Length: docs/PUMP_SKID.md prototype value. Body diameter: E1a fixture choice."
        },
        "asm-dn50-liquid-service": {
          "description": "All process ports are DN50 (a nominal designation in millimetres, not an outside diameter) in liquid service. Duty, flow, pressure, temperature, material, and wall thickness are unknown. The prototype omits operating and safety design.",
          "source": "docs/PUMP_SKID.md prototype assumption."
        },
        "asm-dn50-pipe": {
          "description": "All five process connections are DN50 with an assumed 0.0603 m outside diameter. This is not a selected pipe schedule or fabrication specification. Liquid service with unknown duty, flow, pressure, temperature, material, and wall thickness.",
          "source": "docs/PUMP_SKID.md prototype assumption."
        },
        "asm-guided-routes": {
          "description": "Guided orthogonal centreline routes chosen once for the fixture, leaving and entering each nozzle along its axis: tank to suction valve (0.5, 0, 0.2) to (0.72, 0, 0.2); suction valve to pump (0.88, 0, 0.2) to (1.175, 0, 0.2); check valve to discharge valve (2.39, 0, 0.7) via (2.7, 0, 0.7) to (2.7, -0.37, 0.7); discharge valve to boundary (2.7, -0.53, 0.7) to (2.7, -0.75, 0.7). No fittings, supports, slope, or clash checks.",
          "source": "E1a fixture choice."
        },
        "asm-indicator-dial": {
          "description": "Conceptual level and pressure indications drawn with an illustrative 0.08 m dial. Not an instrument specification or hookup design.",
          "source": "docs/PUMP_SKID.md prototype value."
        },
        "asm-indicator-mounts": {
          "description": "Conceptual indication mount points: level indication on the tank top centre (0, 0, 1.2); pressure indication on top of the pump discharge line at (1.9, 0, 0.73). No tapping, hookup, or support is modeled.",
          "source": "E1a fixture choice."
        },
        "asm-isolation-valve-dimensions": {
          "description": "Illustrative DN50 suction and discharge isolation valves: face-to-face length 0.16 m and body diameter 0.10 m.",
          "source": "Length: docs/PUMP_SKID.md prototype value. Body diameter: E1a fixture choice."
        },
        "asm-manual-route": {
          "description": "Manually chosen pump discharge route: rises from the pump outlet (1.5, 0, 0.5) to (1.5, 0, 0.7), then runs along +x above the motor to the check valve inlet (2.21, 0, 0.7). Included to exercise preservation of manual routing.",
          "source": "E1a fixture choice."
        },
        "asm-pump-dimensions": {
          "description": "Illustrative centrifugal pump envelopes: body 0.45 m long (x) by 0.30 m wide (y) by 0.40 m high (z); motor 0.35 m long by 0.22 m diameter on the shaft axis. End suction and top discharge follow template centrifugal_pump version 1. Not a vendor selection.",
          "source": "docs/PUMP_SKID.md prototype values."
        },
        "asm-skid-layout": {
          "description": "Illustrative skid arrangement. The deck top is z = 0 m; process flow runs along +x at y = 0 until the discharge turns toward -y. Placement origins use template version 1 local frames: tank shell base centre (0, 0, 0); suction valve centre (0.8, 0, 0.2); pump body base centre (1.5, 0, 0); check valve centre (2.3, 0, 0.7); discharge valve centre (2.7, -0.45, 0.7) and boundary marker centre (2.7, -0.85, 0.7), both rotated -90 degrees about z. Tank and pump nozzles project 0.10 m from their bodies. Not a plant layout, support, or access design.",
          "source": "E1a fixture choice."
        },
        "asm-tank-dimensions": {
          "description": "Illustrative vertical cylindrical tank: diameter 0.8 m and height 1.2 m. The outlet nozzle centreline is 0.2 m above the tank base, chosen to align with the pump suction centreline. Not a vessel design.",
